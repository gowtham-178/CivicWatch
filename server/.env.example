# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==================== SERVER CONFIG ====================
PORT=5000
NODE_ENV=development
HOST=localhost

# ==================== DATABASE ====================
# For local development:
MONGODB_URI=mongodb://localhost:27017/civicwatch

# For MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civicwatch?retryWrites=true&w=majority

# ==================== JWT AUTHENTICATION ====================
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRE=7d

# ==================== EMAIL SERVICE ====================
# Gmail SMTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# For other email providers, update the transporter config in auth.js

# ==================== CORS & CLIENT ====================
CLIENT_URL=http://localhost:3000

# ==================== FILE UPLOADS ====================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ==================== ADMIN CREDENTIALS ====================
# Create admin using: node createAdmin.js
ADMIN_DEFAULT_PASSWORD=Admin@123

# ==================== LOGGING ====================
LOG_LEVEL=debug

# ==================== DATABASE SEED ====================
# Set to true to seed initial categories on startup
SEED_DATABASE=false

# ==================== API RATE LIMITING ====================
# (Optional - for future implementation)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

