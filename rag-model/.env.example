# MongoDB Connection String (Atlas URI in production or local URI)
MONGODB_URI=mongodb://localhost:27017/civicwatch

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Microservice Port
PORT=8000

# Allowed CORS Origins (comma-separated for multiple origins, or * for all)
CORS_ORIGINS=*

# Environment (development / production)
ENVIRONMENT=production
